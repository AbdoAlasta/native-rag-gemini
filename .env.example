# Copy to .env and fill in. Never commit .env.
# NOTE: this version needs its OWN database (vector size differs from the bge-m3 version).
DATABASE_URL=postgresql://rag:ragpass@localhost:5433/native_rag_gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Gemini embeddings (replaces the local bge-m3 model)
# gemini-embedding-2 (multimodal, 8192-token inputs). gemini-embedding-001 also works.
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_RETRIES=6
SERVICE_API_KEY=change-me
# Retrieval / chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=8
